<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="mainPanel" styleClass="baseScene" stylesheets="@constants.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.edu.pwr.pwrinspace.poliwrocket.Controller.EditSensorsController" prefHeight="370.0" prefWidth="800.0">
    <JFXComboBox fx:id="sensorTypeFilter" prefWidth="300.0" layoutX="15.0" layoutY="15.0" promptText="sensor type" />
    <JFXTextField fx:id="nameFilter" prefWidth="300.0" layoutX="15.0" prefHeight="25" layoutY="50.0" promptText="name"/>
    <JFXListView fx:id="sensorListView" prefWidth="300.0" prefHeight="215.0" layoutX="15" layoutY="90.0"/>

    <JFXTextField fx:id="nameTextField" prefWidth="200.0" prefHeight="25.0" layoutX="330.0" layoutY="15.0" promptText="name"/>
    <JFXTextField fx:id="unitTextField" prefWidth="200.0" prefHeight="25.0" layoutX="330.0" layoutY="55.0" promptText="unit"/>
    <JFXTextField fx:id="maxRangeTextField" prefWidth="200.0" prefHeight="25.0" layoutX="330.0" layoutY="95.0" promptText="maxRange"/>
    <JFXTextField fx:id="minRangeTextField" prefWidth="200.0" prefHeight="25.0" layoutX="330.0" layoutY="135.0" promptText="minRange"/>
    <JFXCheckBox fx:id="isBooleanCheckbox" prefWidth="200.0" prefHeight="25.0" layoutX="330.0" layoutY="175.0" text="isBoolean"/>
    <JFXComboBox fx:id="interpreterKeyComboBox" prefWidth="200.0" prefHeight="25.0" layoutX="330.0" layoutY="215.0" promptText="interpreterKey"/>
    <JFXCheckBox fx:id="hiddenCheckBox" prefWidth="200.0" prefHeight="25.0" layoutX="330.0" layoutY="255.0" text="hidden"/>

<!--byte sensor fields-->
    <JFXComboBox fx:id="byteSubSensorComboBox" prefWidth="200.0" prefHeight="25.0" layoutX="585.0" layoutY="295.0" promptText="bitSensorNumber" visible="false"/>
    <JFXTextField fx:id="multiBitSensorTextField" prefWidth="90.0" prefHeight="25.0" layoutX="585.0" layoutY="335.0" promptText="bits" visible="false"/>
    <JFXComboBox fx:id="multiBitSensorDirectionComboBox" prefWidth="90.0" prefHeight="25.0" layoutX="690.0" layoutY="335.0" promptText="direction" visible="false"/>

    <JFXButton fx:id="saveEditButton" prefWidth="150.0" layoutX="325" layoutY="335.0" text="Save changes" onAction="#saveEdit"/>
</AnchorPane>
