<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.edu.pwr.pwrinspace.poliwrocket.Controller.AddExistingCommandController" prefHeight="600.0" prefWidth="600.0">
    <Region style="-fx-background-image: url('silly_cat_4.jpeg'); -fx-background-position: center, center; -fx-background-size: cover, cover" />
    <AnchorPane prefHeight="450.0" prefWidth="350.0" styleClass="baseScene" stylesheets="@constants.css">
        <JFXComboBox fx:id="commandTypeFilter" prefWidth="570.0" layoutX="15.0" layoutY="15.0" promptText="command type" />
        <JFXComboBox fx:id="deviceFilter" prefWidth="277.5" layoutX="15.0" layoutY="45.0" promptText="device" />
        <JFXComboBox fx:id="systemFilter" prefWidth="277.5" layoutX="307.5" layoutY="45.0" promptText="system" />
        <JFXTextArea fx:id="descriptionFilter" prefWidth="180.0" layoutX="15.0" prefHeight="40" layoutY="80.0" promptText="description"/>
        <JFXTextArea fx:id="triggerFilter" prefWidth="180.0" layoutX="210.0" prefHeight="40" layoutY="80.0" promptText="trigger"/>
        <JFXTextArea fx:id="commandFilter" prefWidth="180.0" layoutX="405.0" prefHeight="40" layoutY="80.0" promptText="command"/>
        <JFXToggleButton fx:id="isFinalFilter" text="IsFinal" layoutY="120.0" layoutX="200.0" prefWidth="200"/>
        <JFXListView fx:id="commandListView" prefWidth="570.0" prefHeight="370.0" layoutX="15" layoutY="175.0"/>
        <JFXButton fx:id="addExistingCommandButton" prefWidth="300.0" layoutX="150.0" layoutY="560.0" text="Add existing command" onAction="#addExistingCommand"/>
    </AnchorPane>
</StackPane>
