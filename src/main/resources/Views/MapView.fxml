<?import com.jfoenix.controls.JFXTextField?>
<?import com.sothawo.mapjfx.MapView?>
<?import javafx.scene.layout.*?>
<BorderPane stylesheets="@constants.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.edu.pwr.pwrinspace.poliwrocket.Controller.MapController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="5.0" BorderPane.alignment="CENTER">
         <JFXTextField fx:id="currentDistance" editable="false" prefHeight="26.0" HBox.hgrow="ALWAYS" styleClass="map-cords" />
      </HBox>
   </top>
   <center>
      <MapView fx:id="mapView" minHeight="50.0" minWidth="50.0" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="5.0" BorderPane.alignment="CENTER">
         <JFXTextField fx:id="currentLocation" editable="false" prefHeight="26.0" HBox.hgrow="ALWAYS" styleClass="map-cords" />
      </HBox>
   </bottom>
</BorderPane>