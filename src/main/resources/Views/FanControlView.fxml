<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import com.jfoenix.controls.JFXButton?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pl.edu.pwr.pwrinspace.poliwrocket.Controller.FanControlController"
            prefHeight="94.0" prefWidth="128.0"
            styleClass="baseScene" stylesheets="@constants.css">
    <JFXButton fx:id="fanOnButton" onAction="#handleFanOnButtonClick" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="100.0" text="FAN ON" />
    <JFXButton fx:id="fanOffButton" onAction="#handleFanOffButtonClick" layoutX="14.0" layoutY="56.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="100.0" text="FAN OFF" />
</AnchorPane>
