<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXTextArea?>
<?import javafx.scene.SceneAntialiasing?>
<?import javafx.scene.SubScene?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1550.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.edu.pwr.pwrinspace.poliwrocket.Controller.MainController">
  <children>
    <MenuBar VBox.vgrow="NEVER" />
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-image: url('background.jpg'); -fx-background-size: stretch; -fx-background-color: grey;" stylesheets="@constants.css">
      <children>
            <SubScene fx:id="dataScene" height="480.0" layoutX="15.0" layoutY="10.0" width="205.0">
              <root>
                <Region />
              </root>
            </SubScene>
            <SubScene fx:id="powerScene" height="252.0" layoutX="15.0" layoutY="500.0" width="205.0">
              <root>
                <Region />
              </root>
            </SubScene>
            <SubScene fx:id="abortScene" height="110.0" layoutX="1117.0" layoutY="685.0" width="418.0">
               <root>
                  <Region />
               </root>
            </SubScene>
            <AnchorPane fx:id="footer" layoutX="14.0" layoutY="762.0" prefHeight="30.0" prefWidth="206.0" styleClass="baseScene" stylesheets="@constants.css">
               <children>
                  <Label layoutX="4.0" layoutY="4.0" prefHeight="18.0" prefWidth="90.0" text="Software by Jan Zmysłowski">
                     <font>
                        <Font size="7.0" />
                     </font>
                  </Label>
                  <ImageView fx:id="poliwrocketLogo" fitHeight="20.0" fitWidth="20.0" layoutX="170.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" />
                  <ImageView fx:id="inSpaceLogo" fitHeight="20.0" fitWidth="75.0" layoutX="100.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </AnchorPane>
            <SubScene fx:id="rawDataScene" height="298.0" layoutX="1116.0" layoutY="10.0" width="418.0">
               <root>
                  <Region />
               </root>
            </SubScene>
            <TabPane fx:id="tabPane" layoutX="225.0" layoutY="10.0" prefHeight="786.0" prefWidth="890.0" tabClosingPolicy="UNAVAILABLE">
              <tabs>
                <Tab closable="false" text="Filling">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="754.0" prefWidth="890.0">
                           <children>
                              <SubScene fx:id="liquidDataScene" height="737.0" layoutX="14.0" layoutY="14.0" width="410.0">
                                 <root>
                                    <Region />
                                 </root>
                              </SubScene>
                              <SubScene fx:id="liquidCommandsScene" height="737.0" layoutX="434.0" layoutY="14.0" width="440.0">
                                 <root>
                                    <Region />
                                 </root>
                              </SubScene>
                           </children>
                        </AnchorPane>
                  </content>
                </Tab>
                  <Tab closable="false" text="Commands">
                      <content>
                          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="754.0" prefWidth="890.0">
                              <children>
                                  <SubScene fx:id="additionalCommandsScene" height="744.0" layoutX="10.0" layoutY="10.0" width="870.0">
                                      <root>
                                          <Region />
                                      </root>
                                  </SubScene>
                              </children>
                          </AnchorPane>
                      </content>
                  </Tab>
                  <Tab closable="false" text="Fire">
                      <content>
                          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="754.0" prefWidth="890.0">
                              <children>
                                  <SubScene fx:id="fireDataScene" height="620.0" layoutX="14.0" layoutY="14.0" width="410.0">
                                      <root>
                                          <Region />
                                      </root>
                                  </SubScene>
                                  <SubScene fx:id="armingCommandsScene" height="577.0" layoutX="434.0" layoutY="14.0" width="440.0">
                                      <root>
                                          <Region />
                                      </root>
                                  </SubScene>
                                  <SubScene fx:id="armingIndicatorsScene" height="140.0" layoutX="434.0" layoutY="601.0" width="440.0">
                                      <root>
                                          <Region />
                                      </root>
                                  </SubScene>
                                  <SubScene fx:id="launchScene" height="110.0" layoutX="14.0" layoutY="640.0" width="410.0">
                                      <root>
                                          <Region />
                                      </root>
                                  </SubScene>
                              </children>
                          </AnchorPane>
                      </content>
                  </Tab>

                  <Tab text="Settings">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <SubScene fx:id="rocketSettingsScene" height="744.0" layoutX="10.0" layoutY="10.0" width="870.0">
                                 <root>
                                    <Region />
                                 </root>
                              </SubScene>
                           </children>
                        </AnchorPane>
                    </content>
                  </Tab>
                  <Tab text="Connection">
                     <content>
                         <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                             <SubScene fx:id="connectionScene" height="744.0" layoutX="10.0" layoutY="10.0" width="870.0">
                                <root>
                                    <Region />
                                </root>
                             </SubScene>
                         </AnchorPane>
                     </content>
                  </Tab>
                  <Tab text="Other">
                      <content>
                          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                              <SubScene fx:id="otherScene" height="744.0" layoutX="10.0" layoutY="10.0" width="870.0">
                                  <root>
                                      <Region />
                                  </root>
                              </SubScene>
                          </AnchorPane>
                      </content>
                  </Tab>
              </tabs>
            </TabPane>
            <JFXTextArea fx:id="inComing" editable="false" layoutX="1115.0" layoutY="318.0" prefHeight="96.0" prefWidth="418.0" />
            <JFXTextArea fx:id="outGoing" editable="false" layoutX="1115.0" layoutY="424.0" prefHeight="96.0" prefWidth="418.0" />

            <SubScene fx:id="liquidIndicatorsScene" height="150.0" layoutX="1115.0" layoutY="530.0" width="418.0">
               <root>
                  <Region />
               </root>
            </SubScene>
      </children>
    </AnchorPane>
  </children>
</VBox>
